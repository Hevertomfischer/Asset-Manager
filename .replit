modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["glib", "nspr", "nss", "atk", "at-spi2-atk", "dbus", "cups", "xorg.libxcb", "libxkbcommon", "alsa-lib", "mesa", "xorg.libX11", "xorg.libXext", "cairo", "pango", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXfixes", "xorg.libXrandr", "libgbm"]

[userenv]

[userenv.production]
APP_URL = "https://mitometro.com.br"

[userenv.shared]
FIRST_ADMIN_EMAIL = "hevertom.fischer@gmail.com"
